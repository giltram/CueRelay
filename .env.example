# Generate a private random value; never use this placeholder for real accounts.
DJANGO_SECRET_KEY=replace-with-a-private-random-secret
# 1: local HTTP; 0: production HTTPS with Secure cookies
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGDATABASE=cuerelay
PGUSER=cuerelay
PGPASSWORD=replace-with-your-local-database-password
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer
# Same-origin production does not need additional origins.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional public diagnostic build labels; never put secrets in these values.
CUERELAY_BUILD=unknown
VITE_CUERELAY_BUILD=unknown
# Single-process only; otherwise use stderr + deployment-managed rotation.
# CUERELAY_DIAGNOSTIC_LOG=/absolute/private/path/diagnostics.log

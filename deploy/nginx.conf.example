# Include this server in nginx's http context. Set the host, paths and upstream
# for your deployment; terminate HTTPS here or at your existing trusted ingress.
server {
    listen 8080;
    server_name localhost;
    root /srv/cuerelay/frontend/dist;
    index index.html;

    proxy_set_header Host $http_host;

    # API/Admin requests must never fall through to the SPA, including errors.
    # Match Django DATA_UPLOAD_MAX_MEMORY_SIZE. JSON contains both the source
    # template and editable cues; the separate 1MiB ASS limit still applies.
    location = /api {
        client_max_body_size 3m;
        error_page 413 = @api_body_too_large;
        proxy_pass http://127.0.0.1:8000;
    }
    location ^~ /api/ {
        client_max_body_size 3m;
        error_page 413 = @api_body_too_large;
        proxy_pass http://127.0.0.1:8000;
    }
    location @api_body_too_large {
        default_type application/json;
        return 413 '{"issues":[{"code":"too_large","message":"请求体不能超过 3MiB"}],"error":{"code":"too_large","message":"请求体不能超过 3MiB"}}';
    }
    location = /admin { proxy_pass http://127.0.0.1:8000; }
    location ^~ /admin/ { proxy_pass http://127.0.0.1:8000; }

    # Collect Django Admin static assets separately; do not use SPA fallback.
    location ^~ /static/ { alias /srv/cuerelay/django-static/; }
    location ^~ /assets/ {
        include /etc/nginx/snippets/cuerelay-frontend-headers.conf;
        try_files $uri =404;
    }
    location = /index.html {
        include /etc/nginx/snippets/cuerelay-frontend-headers.conf;
        try_files $uri =404;
        add_header Cache-Control no-cache;
    }
    location / {
        include /etc/nginx/snippets/cuerelay-frontend-headers.conf;
        try_files $uri /index.html;
    }
}

{
  "name": "cuerelay-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:audio-audition": "node browser-tests/audio-audition.mjs",
    "test:audio-browser": "node browser-tests/local-audio.mjs",
    "test:audio-preferences": "node browser-tests/audio-preferences.mjs",
    "test:personal-settings-pending": "node browser-tests/personal-settings-pending.mjs",
    "test:audio-timeline": "node browser-tests/audio-timeline.mjs",
    "test:audio-lifecycle": "node browser-tests/audio-lifecycle.mjs",
    "test:navigation": "node browser-tests/navigation.mjs",
    "test:project-form": "node browser-tests/project-form.mjs",
    "test:project-settings": "node browser-tests/project-settings.mjs",
    "test:cue-table": "node browser-tests/cue-table.mjs",
    "test:video-progress": "node browser-tests/video-progress.mjs",
    "test:fullscreen-playback": "node browser-tests/fullscreen-playback.mjs",
    "test:ass-preview": "node browser-tests/ass-preview.mjs",
    "test:style-management": "node browser-tests/style-management.mjs",
    "test:tab-navigation": "node browser-tests/tab-navigation.mjs",
    "test:subtitle-focus": "node browser-tests/subtitle-focus.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:editing-operations": "node browser-tests/editing-operations.mjs",
    "test:workspace-history": "node browser-tests/workspace-history.mjs",
    "test:diagnostics": "node browser-tests/diagnostics.mjs && node browser-tests/diagnostics-errors.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "fft.js": "4.0.4",
    "jassub": "2.5.23",
    "mediabunny": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

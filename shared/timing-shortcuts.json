{
  "commit": {"label": "提交并下一条", "bindings": ["KeyG", "Enter", "NumpadEnter"]},
  "selection": {"label": "单次播放选区", "bindings": ["KeyS", "Space"]},
  "before-start": {"label": "播放入点前 500ms", "bindings": ["KeyQ"]},
  "after-end": {"label": "播放出点后 500ms", "bindings": ["KeyW"]},
  "first-500": {"label": "播放选区开头 500ms", "bindings": ["KeyE"]},
  "last-500": {"label": "播放选区结尾 500ms", "bindings": ["KeyD"]},
  "delete-row": {"label": "删除当前字幕行", "bindings": ["Ctrl+Delete", "Meta+Delete", "Ctrl+Backspace", "Meta+Backspace"]},
  "set-start-playhead": {"label": "设置入点为播放头", "bindings": []},
  "set-end-playhead": {"label": "设置出点为播放头", "bindings": []},
  "split-playhead": {"label": "在播放头位置拆分字幕", "bindings": []},
  "split-text": {"label": "在文本光标位置拆分字幕", "bindings": []},
  "undo": {"label": "撤销", "bindings": ["Ctrl+KeyZ", "Meta+KeyZ"]},
  "redo": {"label": "重做", "bindings": ["Ctrl+Shift+KeyZ", "Meta+Shift+KeyZ"]},
  "toggle-text-focus": {"label": "字幕输入焦点切换", "bindings": ["Tab"], "allowed_bindings": ["Tab", "Ctrl+Space"]},
  "insert-before": {"label": "在当前行前插入字幕", "bindings": ["Ctrl+Alt+KeyI", "Meta+Alt+KeyI"]},
  "insert-after": {"label": "在当前行后插入字幕", "bindings": ["Ctrl+Alt+Shift+KeyI", "Meta+Alt+Shift+KeyI"]},
  "insert-video-before": {"label": "在当前行前按视频时间插入", "bindings": ["Ctrl+Alt+KeyV", "Meta+Alt+KeyV"]},
  "insert-video-after": {"label": "在当前行后按视频时间插入", "bindings": ["Ctrl+Alt+Shift+KeyV", "Meta+Alt+Shift+KeyV"]},
  "duplicate-lines": {"label": "重复字幕行", "bindings": ["Ctrl+Shift+KeyU", "Meta+Shift+KeyU"]},
  "split-frame-before": {"label": "在当前帧前分割字幕行", "bindings": ["Ctrl+KeyD", "Meta+KeyD"]},
  "split-frame-after": {"label": "在当前帧后分割字幕行", "bindings": ["Ctrl+Shift+KeyD", "Meta+Shift+KeyD"]},
  "cut-lines": {"label": "剪切字幕行", "bindings": ["Ctrl+KeyX", "Meta+KeyX"]},
  "copy-lines": {"label": "复制字幕行", "bindings": ["Ctrl+KeyC", "Meta+KeyC"]},
  "paste-lines": {"label": "粘贴字幕行", "bindings": ["Ctrl+KeyV", "Meta+KeyV"]},
  "paste-lines-over": {"label": "选择字段粘贴覆盖字幕行", "bindings": ["Ctrl+Shift+KeyV", "Meta+Shift+KeyV"]}
}
